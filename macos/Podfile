minimum_macos_version = '12.0'
platform :osx, minimum_macos_version

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  settings = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(settings)
    raise "#{settings} must exist. Run flutter pub get before pod install."
  end
  File.foreach(settings) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{settings}. Run flutter pub get again."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  # Plugins without Swift Package Manager support still need CocoaPods.
  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      current = config.build_settings['MACOSX_DEPLOYMENT_TARGET'] || '0'
      if Gem::Version.new(current) < Gem::Version.new(minimum_macos_version)
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = minimum_macos_version
      end
    end
  end
end
